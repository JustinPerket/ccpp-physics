[ccpp-table-properties]
  name = GFS_surface_generic_pre
  type = scheme
  dependencies = machine.F,surface_perturbation.F90

########################################################################
[ccpp-arg-table]
  name = GFS_surface_generic_pre_init
  type = scheme
[nthreads]
